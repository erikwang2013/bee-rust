+/// The host part — after `://`, up to the first `/`, `?`, `#` or the end — must be non-empty.
+fn has_host(url: &str) -> bool {
+    let Some(after_scheme) = url.find("://").map(|i| &url[i + 3..]) else {
+        return false;
+    };
+    !after_scheme.split(['/', '?', '#']).next().unwrap_or("").is_empty()
+}
